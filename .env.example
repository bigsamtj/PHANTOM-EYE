# Environment Configuration Template for Phantom Eye Security Platform

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('development' | 'production')
NODE_ENV="development"

# GEMINI_API_KEY: Optional API key for AI Studio & automated reasoning
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted
APP_URL="https://phantom-eye.local"

# =============================================================================
# TELEGRAM INTEGRATION: Automated executive report dispatch
# Paste your actual Bot Token and Telegram Chat ID directly below:
# Example Bot Token: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Example Chat ID: -1001234567890 or 987654321
# =============================================================================
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"

# SCAN THREADS & RATE LIMITS
DEFAULT_SCAN_THREADS=10
DEFAULT_REQUEST_RATE_LIMIT=15
DEFAULT_REQUEST_TIMEOUT=8
